<%@ page import="com.bloodbank.dao.BloodDAO,com.bloodbank.dao.RequestDAO,java.util.*" contentType="text/html;charset=UTF-8" %><%if(session.getAttribute("admin")==null){response.sendRedirect("login.jsp");return;}%><!DOCTYPE html><html><head><title>Admin Dashboard</title><link rel="stylesheet" href="../css/style.css"></head><body><nav><a class="brand" href="../index.jsp">♥ Admin Dashboard</a><a href="../availability.jsp">Public Availability</a><a href="../logout">Logout</a></nav><main class="container"><h1>Admin Dashboard</h1><p class="muted">Signed in as <%=session.getAttribute("admin")%>.</p><%if(request.getParameter("stock")!=null){%><div class="alert">Stock updated.</div><%}if(request.getParameter("updated")!=null){%><div class="alert">Request status updated.</div><%}%><section class="panel"><h2>Update Blood Stock</h2><form action="../admin-stock" method="post"><div class="grid"><label>Blood group<select name="bloodGroup"><option>A+</option><option>A-</option><option>B+</option><option>B-</option><option>AB+</option><option>AB-</option><option>O+</option><option>O-</option></select></label><label>Units<input type="number" name="units" min="0" required></label></div><button class="btn">Save Stock</button></form></section><h2>Current Stock</h2><div class="table-wrap"><table><tr><th>Group</th><th>Units</th><th>Last updated</th></tr><%try{for(Map<String,Object> r:new BloodDAO().stock()){%><tr><td><%=r.get("group")%></td><td><%=r.get("units")%></td><td><%=r.get("updated")%></td></tr><%}}catch(Exception e){%><tr><td colspan="3">Database error.</td></tr><%}%></table></div><h2>Blood Requests</h2><div class="table-wrap"><table><tr><th>ID</th><th>Donor</th><th>Patient</th><th>Group</th><th>Units</th><th>Hospital</th><th>Phone</th><th>Status</th><th>Update</th></tr><%try{for(Map<String,Object> r:new RequestDAO().list(null)){String st=(String)r.get("status");%><tr><td><%=r.get("id")%></td><td><%=r.get("donor")%></td><td><%=r.get("patient")%></td><td><%=r.get("group")%></td><td><%=r.get("units")%></td><td><%=r.get("hospital")%></td><td><%=r.get("phone")%></td><td><span class="status <%=st%>"><%=st%></span></td><td><form action="../admin-status" method="post" style="display:flex;gap:5px;min-width:190px"><input type="hidden" name="id" value="<%=r.get("id")%>"><select name="status"><option <%=st.equals("Pending")?"selected":""%>>Pending</option><option <%=st.equals("Approved")?"selected":""%>>Approved</option><option <%=st.equals("Rejected")?"selected":""%>>Rejected</option></select><button class="btn">Save</button></form></td></tr><%}}catch(Exception e){%><tr><td colspan="9">Could not load requests. Check database connection.</td></tr><%}%></table></div></main></body></html>

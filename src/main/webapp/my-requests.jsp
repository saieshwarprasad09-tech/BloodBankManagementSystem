<%@ page import="com.bloodbank.dao.RequestDAO,java.util.*" contentType="text/html;charset=UTF-8" %><%if(session.getAttribute("donorId")==null){response.sendRedirect("login.jsp");return;}%><!DOCTYPE html><html><head><title>My Requests</title><link rel="stylesheet" href="css/style.css"></head><body><nav><a class="brand" href="dashboard.jsp">♥ LifeLine Blood Bank</a><a href="availability.jsp">Availability</a><a href="request-blood.jsp">Request Blood</a><a href="logout">Logout</a></nav><main class="container"><h1>My Requests</h1><%if(request.getParameter("submitted")!=null){%><div class="alert">Request submitted for admin review.</div><%}%><div class="table-wrap"><table><tr><th>ID</th><th>Patient</th><th>Group</th><th>Units</th><th>Hospital</th><th>Status</th><th>Submitted</th></tr><%try{for(Map<String,Object> r:new RequestDAO().list((Integer)session.getAttribute("donorId"))){String st=(String)r.get("status");%><tr><td><%=r.get("id")%></td><td><%=r.get("patient")%></td><td><%=r.get("group")%></td><td><%=r.get("units")%></td><td><%=r.get("hospital")%></td><td><span class="status <%=st%>"><%=st%></span></td><td><%=r.get("created")%></td></tr><%}}catch(Exception e){%><tr><td colspan="7">Could not load requests. Check database connection.</td></tr><%}%></table></div></main></body></html>

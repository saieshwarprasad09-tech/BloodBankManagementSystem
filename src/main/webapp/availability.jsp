<%@ page import="com.bloodbank.dao.BloodDAO,java.util.*" contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Blood Availability</title><link rel="stylesheet" href="css/style.css"></head><body><nav><a class="brand" href="index.jsp">♥ LifeLine Blood Bank</a><a href="register.jsp">Register</a><a href="login.jsp">Login</a><a href="admin/login.jsp">Admin</a></nav><main class="container"><h1>Blood Availability</h1><p class="muted">Demo stock only, not live hospital inventory.</p><div class="table-wrap"><table><tr><th>Blood group</th><th>Units</th><th>Status</th></tr><%try{for(Map<String,Object> r:new BloodDAO().stock()){int u=(Integer)r.get("units");%><tr><td><b><%=r.get("group")%></b></td><td><%=u%></td><td><span class="status <%=u>0?"Approved":"Rejected"%>"><%=u>0?"Listed":"No demo units"%></span></td></tr><%}}catch(Exception e){%><tr><td colspan="3">Could not load stock. Check database connection.</td></tr><%}%></table></div><a class="btn" href="request-blood.jsp">Request Blood</a></main></body></html>

<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Donor Login</title><link rel="stylesheet" href="css/style.css"></head><body><nav><a class="brand" href="index.jsp">♥ LifeLine Blood Bank</a><a href="register.jsp">Register</a></nav><main class="container"><section class="panel"><h1>Donor Login</h1><%if(request.getParameter("registered")!=null){%><div class="alert">Registration successful. Log in now.</div><%}%><%if(request.getParameter("error")!=null){%><div class="alert">Incorrect email or password.</div><%}%><form action="login" method="post"><label>Email<input type="email" name="email" required></label><label>Password<input type="password" name="password" required></label><button class="btn">Login</button></form></section></main></body></html>

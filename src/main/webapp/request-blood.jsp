<%@ page contentType="text/html;charset=UTF-8" %><%if(session.getAttribute("donorId")==null){response.sendRedirect("login.jsp");return;}%><!DOCTYPE html><html><head><title>Request Blood</title><link rel="stylesheet" href="css/style.css"></head><body><nav><a class="brand" href="dashboard.jsp">♥ LifeLine Blood Bank</a><a href="availability.jsp">Availability</a><a href="my-requests.jsp">My Requests</a><a href="logout">Logout</a></nav><main class="container"><section class="panel"><h1>Request Blood</h1><p class="muted">Submission is not a guarantee of blood supply; admin reviews requests.</p><%if(request.getParameter("error")!=null){%><div class="alert">Check the values and try again.</div><%}%><form action="request-blood" method="post"><div class="grid"><label>Patient name<input name="patientName" required></label><label>Blood group<select name="bloodGroup"><option>A+</option><option>A-</option><option>B+</option><option>B-</option><option>AB+</option><option>AB-</option><option>O+</option><option>O-</option></select></label><label>Units needed<input type="number" name="units" min="1" max="20" required></label><label>Hospital name<input name="hospital" required></label><label>Contact phone<input name="phone" required></label></div><label>Notes<textarea name="notes" maxlength="255"></textarea></label><button class="btn">Submit Request</button></form></section></main></body></html>

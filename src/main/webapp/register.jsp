<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Register Donor</title><link rel="stylesheet" href="css/style.css"></head><body><nav><a class="brand" href="index.jsp">♥ LifeLine Blood Bank</a><a href="login.jsp">Login</a><a href="availability.jsp">Availability</a></nav><main class="container"><section class="panel"><h1>Donor Registration</h1><p class="muted">Demo eligibility rule: age 18–65.</p><%if(request.getParameter("error")!=null){%><div class="alert">Registration failed. Check details and make sure this email is not already registered.</div><%}%><form action="register" method="post"><div class="grid"><label>Full name<input name="fullName" required></label><label>Email<input type="email" name="email" required></label><label>Password<input type="password" name="password" required></label><label>Phone<input name="phone" required></label><label>Age<input type="number" name="age" min="18" max="65" required></label><label>Gender<select name="gender" required><option>Prefer not to say</option><option>Female</option><option>Male</option><option>Other</option></select></label><label>Blood group<select name="bloodGroup" required><option>A+</option><option>A-</option><option>B+</option><option>B-</option><option>AB+</option><option>AB-</option><option>O+</option><option>O-</option></select></label><label>City<input name="city"></label></div><button class="btn">Register Donor</button></form></section></main></body></html>
